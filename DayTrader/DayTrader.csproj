<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
      <Compile Update="**\*.xaml.cs">
      </Compile>
      <EmbeddedResource Include="**\*.xaml">
          <SubType>Designer</SubType>
      </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DigitalRuby.ExchangeSharp" Version="1.2.1" />
    <PackageReference Include="Material.Icons.WPF" Version="2.4.1" />
    <PackageReference Include="MessagePack" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DayTradeScanner\DayTradeScanner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="settings3.dat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
